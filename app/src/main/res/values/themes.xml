<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Single source of truth theme. Extends DayNight so it auto-switches
         between light/dark based on system setting -->
    <style name="Theme.RailRadar" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_200</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar: use theme attr, not a fixed hex, so it also flips with dark mode -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>

        <!-- IMPORTANT:
             Do NOT set android:textColorPrimary / textColorSecondary / hintTextColor
             here to a fixed color like black. Material3.DayNight already provides
             correct ?attr/colorOnSurface and ?attr/colorOnSurfaceVariant that
             automatically flip between dark-on-light and light-on-dark.
             If you truly need custom text colors, define them as color resources
             with a values-night/ override (see colors.xml below), never a single
             hardcoded hex in the theme. -->
    </style>

</resources>