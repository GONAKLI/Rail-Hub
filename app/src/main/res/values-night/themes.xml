<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Same style name as values/themes.xml — Android auto-picks this
         version when system is in dark mode. Do NOT put android:textColor*
         or hintTextColor overrides here; Material DayNight base already
         handles those correctly via colorOnSurface/colorOnBackground. -->
    <style name="Theme.RailRadar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">@color/card_text_secondary</item>
        <item name="android:background">#1A1108</item>
    </style>

</resources>