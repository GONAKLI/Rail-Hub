<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RailRadar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary/Secondary -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/gradient_end</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/card_text_primary</item>
        <item name="android:colorBackground">@color/chip_accent</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="android:textColor">#448AFF</item>
        <item name="hintTextColor">#448AFF</item>
        <!-- Controls -->
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/teal_200</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/chip_accent</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


</resources>