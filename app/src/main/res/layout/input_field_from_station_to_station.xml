<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- From Station -->
        <AutoCompleteTextView
            android:id="@+id/from_station"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:hint="From Station"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:paddingStart="44dp"
            android:paddingEnd="48dp"
            android:background="@drawable/bg_edittext_outlined"
            android:drawableStart="@drawable/ic_station_entry"
            android:drawablePadding="10dp"
            android:textSize="15sp"
            android:textColor="@color/card_text_primary"
            android:textColorHint="@color/card_text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_swap_stations"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/from_station_code_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_station_code_badge"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            tools:text="NDLS"
            app:layout_constraintEnd_toEndOf="@id/from_station"
            app:layout_constraintTop_toTopOf="@id/from_station"
            app:layout_constraintBottom_toBottomOf="@id/from_station" />

        <!-- Swap Button -->
        <ImageButton
            android:id="@+id/btn_swap_stations"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_swap_button"
            android:padding="9dp"
            android:src="@drawable/ic_swap_updown"
            android:contentDescription="Swap stations"
            app:layout_constraintTop_toTopOf="@id/from_station"
            app:layout_constraintBottom_toBottomOf="@id/to_station"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- To Station -->
        <AutoCompleteTextView
            android:id="@+id/to_station"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:hint="To Station"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingStart="44dp"
            android:paddingEnd="48dp"
            android:background="@drawable/bg_edittext_outlined"
            android:drawableStart="@drawable/ic_station_exit"
            android:drawablePadding="10dp"
            android:textSize="15sp"
            android:textColor="@color/card_text_primary"
            android:textColorHint="@color/card_text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_swap_stations"
            app:layout_constraintTop_toBottomOf="@id/from_station"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/to_station_code_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_station_code_badge"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            tools:text="CDG"
            app:layout_constraintEnd_toEndOf="@id/to_station"
            app:layout_constraintTop_toTopOf="@id/to_station"
            app:layout_constraintBottom_toBottomOf="@id/to_station" />

        <!-- Find Trains Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_find_train"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Find Trains"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/bg_button_rounded"
            android:stateListAnimator="@null"
            app:layout_constraintTop_toBottomOf="@id/to_station"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>