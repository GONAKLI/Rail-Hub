<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:minHeight="92dp"
    android:paddingStart="12dp"
    android:paddingEnd="14dp">

    <!-- ===== TIMELINE TRACK ===== -->
    <View
        android:id="@+id/timelineTopLine"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:background="@color/chip_accent"
        app:layout_constraintBottom_toTopOf="@id/timelineDot"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/timelineDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_timeline_dot"
        android:elevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/timelineBottomLine"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:background="@color/chip_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintTop_toBottomOf="@id/timelineDot" />

    <!-- ===== LIVE TRAIN ICON (Z-Index Fix) ===== -->
    <ImageView
        android:id="@+id/liveTrainIcon"
        android:layout_width="45dp"
        android:layout_height="50dp"
        android:contentDescription="Live train position"
        android:elevation="24dp"
        android:src="@drawable/app_train_icon"
        android:translationZ="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/timelineDot"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintTop_toTopOf="@id/timelineDot"
        tools:visibility="visible" />

    <!-- ===== CONTENT AREA ===== -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        app:layout_constraintHorizontal_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/timeContainer"
        app:layout_constraintStart_toEndOf="@id/timelineDot"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/trainStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/card_text_primary"
            android:textSize="15dp"
            tools:text="Fatuhi Junction" />

        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trainDistanceTravelled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/card_text_primary"
                android:textSize="12dp"
                tools:text="77 km" />

            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="6dp"
                android:alpha="0.4"
                android:background="@drawable/bg_timeline_dot" />

            <TextView
                android:id="@+id/trainPlatformNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_platform_chip"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="PF -"
                android:textColor="@color/card_text_primary"
                android:textSize="11dp"
                tools:text="PF - 2" />

            <ImageButton
                android:id="@+id/stationOnMap"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="View on map"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/nearby_station_location_icon"
                app:tint="@color/chip_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== TIME CAPSULE ===== -->
    <LinearLayout
        android:id="@+id/timeContainer"
        android:layout_width="0dp"
        app:layout_constraintHorizontal_weight="1"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_platform_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trainArrivalAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="ARR"
                android:textColor="@color/card_text_primary"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/trainActualArrivalAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textColor="@color/card_text_primary"
                android:textSize="13dp"
                android:textStyle="bold"
                tools:text="10:45"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="8dp"
            android:background="#E5E7EB" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/trainDepartureAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="DEP"
                android:textColor="@color/card_text_primary"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/trainActualDepartureAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:textColor="@color/card_text_primary"
                android:textSize="13dp"
                android:textStyle="bold"
                tools:text="10:48"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>