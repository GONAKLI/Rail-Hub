<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="92dp"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===== TRACK (double line feel) ===== -->
    <View
        android:id="@+id/timelineTopLine"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/chip_accent"
        android:alpha="0.85"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/timelineDot" />

    <!-- Station Marker (bigger + stronger) -->
    <View
        android:id="@+id/timelineDot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_timeline_dot"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/timelineBottomLine"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:background="@color/chip_accent"
        android:alpha="0.85"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintTop_toBottomOf="@id/timelineDot"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Live Train Icon -->
    <ImageView
        android:id="@+id/liveTrainIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="Live train position"
        android:src="@drawable/train_icon_photoroom"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintTop_toTopOf="@id/timelineDot"
        app:layout_constraintBottom_toBottomOf="@id/timelineDot"
        tools:visibility="visible" />

    <!-- ===== CONTENT AREA ===== -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/timelineDot"
        app:layout_constraintEnd_toStartOf="@id/timeColumns"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Station Name -->
        <TextView
            android:id="@+id/trainStationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Fatuhi"
            android:textColor="@color/card_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Details Row -->
        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/trainDistanceTravelled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="77 km"
                android:textColor="@color/card_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_timeline_dot"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/trainPlatformNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PF --"
                android:textColor="@color/card_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_platform_chip" />

            <ImageButton
                android:id="@+id/stationOnMap"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:backgroundTint="@color/black"
                android:scaleType="fitCenter"
                android:src="@drawable/nearby_station_location_icon"
                android:contentDescription="View on map"
                app:tint="@color/chip_accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== TIME COLUMNS (chip style) ===== -->
    <LinearLayout
        android:id="@+id/timeColumns"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ARR -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:paddingHorizontal="4dp"
            android:background="@drawable/bg_platform_chip">

            <TextView
                android:id="@+id/trainArrivalAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARR"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/trainActualArrivalAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- DEP -->
        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="5dp"
            android:paddingHorizontal="4dp"
            android:background="@drawable/bg_platform_chip">

            <TextView
                android:id="@+id/trainDepartureAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEP"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/trainActualDepartureAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Directions (hidden) -->
    <ImageButton
        android:id="@+id/trainStationLocatedAt"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:tint="@color/chip_accent"
        android:contentDescription="Get directions"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/timelineDot"
        app:layout_constraintEnd_toEndOf="@id/timelineDot"
        app:layout_constraintTop_toBottomOf="@id/timelineDot"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>