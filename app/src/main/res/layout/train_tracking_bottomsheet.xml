<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F5F6F8">



    <com.google.android.material.card.MaterialCardView
        android:id="@+id/trainStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ===== TOP ROW: Status + Refresh ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/upperInfoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/refreshButton"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_status_dot"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/tvStatusMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Arrived Kurukshetra Junction"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUpdatedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Updated 25 minutes ago"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="3dp"
                        android:layout_marginStart="17dp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/refreshButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/refresh_icon"
                    android:background="@drawable/bg_refresh_button"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Refresh"
                    app:tint="@color/primary_blue"/>
            </RelativeLayout>

            <!-- ===== JOURNEY PROGRESS SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvFromStation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="New Kaithal Halt"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvToStation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kurukshetra Junction"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/journeyProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="10dp"
                    android:progress="50"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_progress_rounded"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </LinearLayout>

            <!-- ===== NEXT STOP / TO REACH ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_subcard"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEXT STOP"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:id="@+id/tvNextStopName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kurukshetra Junction"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvNextStopMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 km · 6:00 PM"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_info_subcard"
                    android:padding="14dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TO REACH"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_tertiary"
                        android:letterSpacing="0.08"/>

                    <TextView
                        android:id="@+id/tvDestinationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chandigarh Junction"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/tvDestinationMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11 km · 7:00 PM"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== DELAY STATUS BADGE ===== -->
            <LinearLayout
                android:id="@+id/delayBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_delay_pill_success"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginTop="18dp">

<!--                <ImageView-->
<!--                    android:layout_width="15dp"-->
<!--                    android:layout_height="15dp"-->
<!--                    android:src="@drawable/ic_check_circle"-->
<!--                    app:tint="@color/success_green"/>-->

                <TextView
                    android:id="@+id/tvDelayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No delay"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/success_green"
                    android:layout_marginStart="6dp"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.core.widget.NestedScrollView>