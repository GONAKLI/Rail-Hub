<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_passenger_pnr_card"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:elevation="2dp">

    <!-- Top Row: Passenger Number + Current Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/passengerSerialNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Passenger 1"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#1E3A8A" />

        <TextView
            android:id="@+id/currentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CNF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#787474"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Age & Nationality -->
    <TextView
        android:id="@+id/passengerAgeNationality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Age: 23 • Nationality: IN"
        android:textSize="13sp"
        android:textColor="#555555"
        android:paddingTop="6dp" />

    <!-- Berth Choice -->
    <TextView
        android:id="@+id/passengerBerthChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Berth Preference: Side Lower"
        android:textSize="13sp"
        android:textColor="#555555"
        android:paddingTop="2dp" />

    <!-- Booking Details (Coach + Berth) -->
    <TextView
        android:id="@+id/bookingDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coach: D1  •  Berth: 25 (WS)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:paddingTop="6dp" />

</LinearLayout>