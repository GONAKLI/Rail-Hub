<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="11dp"
    android:background="@drawable/bg_passenger_pnr_card"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:elevation="2dp">

    <!-- Top: Passenger + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/passengerSerialNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Passenger 1"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1E3A8A" />

        <TextView
            android:id="@+id/currentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CNF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#2E7D32"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Age + Nationality -->
    <TextView
        android:id="@+id/passengerAgeNationality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Age: 23  •  Nationality: IN"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- Berth Preference -->
    <TextView
        android:id="@+id/passengerBerthChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Berth Preference: Side Lower"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- Coach + Berth (highlighted) -->
    <TextView
        android:id="@+id/bookingDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="#E8F5E9"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:text="Coach: D1  •  Berth: 25 (WS)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1B5E20" />

</LinearLayout>