<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    android:id="@+id/card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Round icon circle -->
        <androidx.cardview.widget.CardView
            android:id="@+id/iconHolder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/chip_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="@color/chip_accent" />

        </androidx.cardview.widget.CardView>

        <!-- Train number badge -->
        <TextView
            android:id="@+id/trainNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_train_number_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="57124"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iconHolder"
            app:layout_constraintTop_toTopOf="@id/iconHolder" />

        <!-- Train name -->
        <TextView
            android:id="@+id/trainName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Shatabdi Express"
            android:textColor="@color/card_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iconHolder"
            app:layout_constraintTop_toBottomOf="@id/trainNumber"
            app:layout_constraintEnd_toStartOf="@id/arrowIcon" />

<!--        &lt;!&ndash; Route row: From -> To &ndash;&gt;-->
