<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="1.5dp"
    app:strokeColor="#12000000"
    app:strokeWidth="1dp"
    app:rippleColor="#1A000000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header Icon (Material Shapeable) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iconHolder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/chip_background"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_directions"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@color/chip_accent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Train Number Badge -->
        <TextView
            android:id="@+id/trainNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_train_number_chip"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/iconHolder"
            app:layout_constraintTop_toTopOf="@id/iconHolder"
            tools:text="12002" />

        <!-- Train Name -->
        <TextView
            android:id="@+id/trainName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/card_text_primary"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/arrowIcon"
            app:layout_constraintStart_toEndOf="@id/iconHolder"
            app:layout_constraintTop_toBottomOf="@id/trainNumber"
            tools:text="Bhopal Shatabdi Express" />

        <!-- Forward Arrow Icon -->
        <ImageView
            android:id="@+id/arrowIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:alpha="0.4"
            android:contentDescription="@null"
            android:src="@android:drawable/ic_media_play"
            app:layout_constraintBottom_toBottomOf="@id/iconHolder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iconHolder"
            app:tint="@color/card_text_primary" />

        <!-- Subtle Divider Line -->
        <View
            android:id="@+id/cardDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:alpha="0.08"
            android:background="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/trainName" />

        <!-- ===== ROUTE SECTION (Source -> Destination) ===== -->

        <!-- Source Station -->
        <TextView
            android:id="@+id/sourceStation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/card_text_primary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/routeIndicatorLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardDivider"
            tools:text="NDLS (New Delhi)" />

        <!-- Middle Visual Route Indicator -->
        <LinearLayout
            android:id="@+id/routeIndicatorLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/sourceStation"
            app:layout_constraintEnd_toStartOf="@+id/destinationStation"
            app:layout_constraintStart_toEndOf="@+id/sourceStation"
            app:layout_constraintTop_toTopOf="@+id/sourceStation">

            <!-- Source Dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_timeline_dot"
                app:backgroundTint="@color/chip_accent" />

            <!-- Connecting Track Line -->
            <View
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginHorizontal="4dp"
                android:alpha="0.3"
                android:background="@color/chip_accent" />

            <!-- Destination Arrow/Dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_timeline_dot"
                app:backgroundTint="@color/chip_accent" />
        </LinearLayout>

        <!-- Destination Station -->
        <TextView
            android:id="@+id/destinationStation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/card_text_primary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@+id/sourceStation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/routeIndicatorLayout"
            app:layout_constraintTop_toTopOf="@+id/sourceStation"
            tools:text="RKMP (Rani Kamlapati)" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>