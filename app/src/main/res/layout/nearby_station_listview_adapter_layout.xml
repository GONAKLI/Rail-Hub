<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp"
    android:background="@drawable/bg_history_items"
    android:layout_marginHorizontal="2dp"
    android:elevation="2dp">

    <!-- Station Name -->
    <TextView
        android:id="@+id/adapterStationName"
        style="@style/nearbyStationDataValuesStationName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:text="Station Name"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Code -->
    <TextView
        android:id="@+id/adapterStationCode"
        style="@style/nearbyStationDataValues"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.7"
        android:text="CODE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1E3A8A"
        android:gravity="center" />

    <!-- Distance -->
    <TextView
        android:id="@+id/adapterStationDistance"
        style="@style/nearbyStationDataValues"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:text="2.4 km"
        android:textSize="13sp"
        android:textColor="#444444"
        android:gravity="center" />

    <!-- Map Icon -->
    <ImageView

        android:id="@+id/nearbyStationMapIcon"
        style="@style/nearbyStationDataImageValues"
        android:src="@drawable/nearby_station_location_icon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Open in Map" />

</LinearLayout>