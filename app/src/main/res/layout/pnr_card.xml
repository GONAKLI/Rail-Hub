<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pnrCardParentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_passenger_pnr_card"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="14dp"
    android:elevation="5dp"
    android:clipToPadding="false"
    android:visibility="visible">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E3A8A"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pnrStatusTrainNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2E4A9E"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="12487"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pnrStatusTrainName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="SEEMANCHAL EXPRESS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pnrStatusPnrNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PNR: 6543217890"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/btnRefreshPnr"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFFFFF"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh PNR" />
    </LinearLayout>

    <!-- ===== DATE + FARE ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pnrStatusJourneyDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="15 Aug 2024"
            android:textColor="#6B21A8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pnrStatusTicketFare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F3E8FF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="₹ 1240"
            android:textColor="#6B21A8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== BOARDING / RESERVATION ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOARDING"
                android:textSize="10sp"
                android:textColor="#888888"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/pnrStatusBoardingPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="DELHI (DLI)"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:background="#E5E5E5" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVATION UPTO"
                android:textSize="10sp"
                android:textColor="#888888"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/pnrStatusReservationUpto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PATNA (PNBE)"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="end"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== CLASS / QUOTA / CHART ===== -->
    <TextView
        android:id="@+id/pnrStatusDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="#EEF2FF"
        android:text="Class: 3A  •  Quota: GN  •  Chart: PREPARED"
        android:textColor="#1E3A8A"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- ===== PASSENGERS ===== -->
    <LinearLayout
        android:id="@+id/pnrStatusPassengerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- ===== INFO MESSAGE ===== -->
    <TextView
        android:id="@+id/pnrStatusInfoMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="#FFEBEE"
        android:text="Info message"
        android:textColor="#B71C1C"
        android:padding="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>