<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pnrCardParentContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_passenger_pnr_card"
    android:padding="12dp"
    android:layout_marginBottom="16dp"
    android:elevation="6dp"
    android:visibility="visible">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E3A8A"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/pnrStatusTrainNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.45"
            android:text="12487"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pnrStatusTrainName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="SEEMANCHAL EXPRESS"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/pnrStatusPnrNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PNR: 6543217890"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Journey Date + Fare -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/pnrStatusJourneyDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Journey Date: 15 Aug 2024"
            android:textColor="#971976"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pnrStatusTicketFare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ticket Fare: "
            android:textColor="#971976"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Boarding & Reservation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/pnrStatusBoardingPoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Boarding: DELHI (DLI)"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pnrStatusReservationUpto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reservation Upto: PATNA (PNBE)"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="end" />
    </LinearLayout>

    <!-- Journey Details -->
    <TextView
        android:id="@+id/pnrStatusDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class: 3A • Quota: GN • Chart Status: CHART PREPARED"
        android:background="#1E3A8A"
        android:textColor="@android:color/white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:textSize="12sp"
        android:letterSpacing="0.02" />

    <!-- Passenger ListView -->
<!--    <ListView-->
<!--        android:id="@+id/pnrStatusPassengerListView"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="210dp"-->
<!--        android:divider="#E8E8E8"-->
<!--        android:dividerHeight="1dp"-->
<!--        android:paddingTop="6dp"-->
<!--        android:paddingBottom="4dp"-->
<!--        android:scrollbars="vertical"-->
<!--        android:nestedScrollingEnabled="true"-->
<!--        android:isScrollContainer="true"-->
<!--        android:cacheColorHint="@android:color/transparent"-->
<!--        android:listSelector="@android:color/transparent"-->
<!--        android:overScrollMode="never"-->
<!--        android:fadeScrollbars="true"-->
<!--        android:fastScrollEnabled="false"-->
<!--        android:smoothScrollbar="true" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/pnrStatusPassengerContainer"
        android:orientation="vertical"
        />

    <!-- Info Message -->
    <TextView
        android:id="@+id/pnrStatusInfoMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Info message"
        android:background="#FF5252"
        android:textColor="@color/black"
        android:padding="10sp"
        android:textSize="15sp"
        android:visibility="gone"
        android:layout_marginTop="6dp" />

</LinearLayout>