<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Search Card -->
    <LinearLayout
        android:id="@+id/pnrSearchContainerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_background"
        android:padding="14dp"
        android:elevation="2dp">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/pnr_search_field"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingHorizontal="14dp"
            android:hint="Enter 10-digit PNR"
            android:maxLength="10"
            android:inputType="number"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/card_text_primary"
            android:textColorHint="@color/card_text_primary"
            android:background="@drawable/pnr_input_field"
            android:gravity="center_vertical"
            android:importantForAutofill="no" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_find_pnr"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Search PNR"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6E40"
            android:background="@drawable/pnr_search_button"
            android:elevation="2dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <!-- PNR List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/allPnrCheckRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="?attr/actionBarSize"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:overScrollMode="never"
        android:scrollbars="none" />
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/pnrLoadingAnimation"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:visibility="gone"
            />
    </FrameLayout>
</LinearLayout>