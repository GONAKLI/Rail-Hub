<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_passenger_pnr_card"
    android:padding="12dp"
    android:elevation="3dp">

    <!-- Previous Station -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:background="#FFF0F0"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Previous"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#B71C1C" />

        <TextView
            android:id="@+id/trackingHeaderPreviousStation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Current Station -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:background="#E8F5E9"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Current"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#2E7D32" />

        <TextView
            android:id="@+id/trackingHeaderCurrentStation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Next Station -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:background="#F5F5F5"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/trackingHeaderNextStation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:text="--"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Status Info -->
    <TextView
        android:id="@+id/trackingHeaderStatusInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:background="#FFF3E0"
        android:text="- - - - -"
        android:textAlignment="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#E65100" />

</LinearLayout>